# Token de Discord Developer Portal > tu aplicación > Bot > Token.
# No es el Client Secret ni la Public Key.
DISCORD_TOKEN=

# API key de OpenAI (https://platform.openai.com/api-keys).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

BOT_NAME=PeBOT
BOT_TZ=America/Lima
COMMAND_PREFIX=!
DB_PATH=bot_vida.db

# IDs de canales separados por comas. Vacío: todos los canales accesibles y DM.
CHANNEL_IDS=

# Horario de silencio para intervenciones aleatorias y espontáneas.
# Responde a menciones, a su nombre y a mensajes privados a cualquier hora.
# Horas iguales desactivan el horario de sueño.
SLEEP_FROM=1
SLEEP_TO=8
MAX_SPONTANEOUS_PER_DAY=6
