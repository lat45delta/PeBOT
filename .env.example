# Token de Discord Developer Portal > tu aplicación > Bot > Token.
# No es el Client Secret ni la Public Key.
DISCORD_TOKEN=

# API key de OpenAI (https://platform.openai.com/api-keys).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Respaldos opcionales: solo se usan proveedores que tengan una clave.
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# https://aistudio.google.com/apikey (también se acepta GEMINI_API_KEY).
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.1-flash-lite

# Prioridad inicial; también admite usar solo deepseek o google.
LLM_PROVIDERS=google,deepseek,openai
# No consulta saldos: espera al error de una petición normal para cambiar.
LLM_QUOTA_COOLDOWN_SECONDS=3600
LLM_RATE_COOLDOWN_SECONDS=60
LLM_ERROR_COOLDOWN_SECONDS=30
LLM_TIMEOUT_SECONDS=30

BOT_NAME=PeBOT
BOT_TZ=America/Lima
COMMAND_PREFIX=!
DB_PATH=bot_vida.db

# IDs de canales separados por comas. Vacío: todos los canales accesibles y DM.
CHANNEL_IDS=

# Tras hablarle, sigue hasta 2 mensajes de esa persona durante 90s. 0 lo desactiva.
CONVERSATION_WINDOW_SECONDS=90

# Respuestas divididas en hasta 3 mensajes, con pausas breves entre ellos (1–5).
MAX_REPLY_MESSAGES=3

# Oportunidades de iniciativa propia; no son consultas de IA por mensaje recibido.
SPONTANEOUS_INTERVAL_MINUTES=15
SPONTANEOUS_IDLE_SECONDS=30
SPONTANEOUS_CHANCE=0.35

# Horario de silencio para iniciativas espontáneas.
# Responde a menciones, a su nombre y a mensajes privados a cualquier hora.
# Horas iguales desactivan el horario de sueño.
SLEEP_FROM=1
SLEEP_TO=8
MAX_SPONTANEOUS_PER_DAY=6

# Voz: Gemini Live usa un modelo distinto al Flash-Lite del chat escrito.
# Vacío reutiliza GOOGLE_API_KEY o GEMINI_API_KEY.
GOOGLE_VOICE_API_KEY=
GOOGLE_VOICE_MODEL=gemini-3.8-live
GOOGLE_VOICE_NAME=Puck
# Canales de voz permitidos, separados por comas. Vacío: canales accesibles.
VOICE_CHANNEL_IDS=
VOICE_MAX_SESSION_MINUTES=15
VOICE_EMPTY_TIMEOUT_SECONDS=60
VOICE_VOLUME=0.8
# No guarda audio. Opcionalmente guarda transcripciones de grupo en SQLite.
VOICE_SAVE_TRANSCRIPTS=false
